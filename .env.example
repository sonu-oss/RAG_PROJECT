# Copy to .env (never commit it) or export in your shell. Everything here is optional.
# Embeddings: minilm (default, free, local) | openai (paid) | hashing (offline tests)
RAG_EMBEDDINGS=minilm
# Only needed with RAG_EMBEDDINGS=openai
OPENAI_API_KEY=
# Answers: local LLM through Ollama (free). Run `ollama pull llama3.2` first.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Where the Streamlit UI finds the FastAPI backend
RAG_API_URL=http://localhost:8000
